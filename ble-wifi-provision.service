[Unit]
Description=BLE Wi-Fi Provisioning Service (TypeScript)
After=bluetooth.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ble-wifi-provision-ts
ExecStart=/usr/bin/node %h/ble-wifi-provision-ts/dist/provision.js
Restart=on-failure
User=root

[Install]
WantedBy=multi-user.target
